# Database (Railway MySQL plugin provides these)
# Quoted deliberately: the query string contains & characters, and an
# unquoted value cannot be loaded with `set -a; . ./.env` — the shell reads
# them as job-control operators and DB_URL comes out empty, which surfaces
# much later as a confusing "Unable to detect database driver" failure.
DB_URL="jdbc:mysql://localhost:3306/hyperlocal_delivery?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true"
DB_USER=root
DB_PASSWORD=your_password_here

# JWT (generate a random 256-bit string: openssl rand -base64 32)
JWT_SECRET=your-secret-at-least-32-bytes-long-here

# CORS (comma-separated origins, or * for development)
CORS_ORIGINS=http://localhost:3000

# Spring profile. Use `dev` locally: the console OTP logger is
# @Profile({"dev","test","mysql-test"}), so with no profile set AND a blank
# SMTP_HOST the app has no OtpEmailService bean at all and refuses to start.
SPRING_PROFILES_ACTIVE=prod

# Password reset: frontend page the emailed reset link points to
# (REQUIRED in prod — no default; the app will fail to start without it)
RESET_LINK_BASE_URL=https://your-frontend.example.com/reset-password

# Password reset token lifetime in minutes (optional, defaults to 30)
RESET_TOKEN_TTL_MINUTES=30

# SMTP (outbound email for OTP codes and password-reset links).
# Leaving SMTP_HOST blank makes the app fall back to logging OTP codes to
# the console instead of emailing (fine for dev, not for real users).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
MAIL_FROM=your-email@gmail.com
