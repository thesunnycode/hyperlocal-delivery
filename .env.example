# Database (Railway MySQL plugin provides these)
# Quoted deliberately: the query string contains & characters, and an
# unquoted value cannot be loaded with `set -a; . ./.env` — the shell reads
# them as job-control operators and DB_URL comes out empty, which surfaces
# much later as a confusing "Unable to detect database driver" failure.
DB_URL="jdbc:mysql://localhost:3306/hyperlocal_delivery?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true"
DB_USER=root
DB_PASSWORD=your_password_here

# JWT (generate a random 256-bit string: openssl rand -base64 32)
JWT_SECRET=your-secret-at-least-32-bytes-long-here

# CORS: comma-separated origins, or * (which disables credentialed requests).
# REQUIRED in prod: if it is unset or blank, StartupValidator aborts startup
# with an error naming CORS_ORIGINS. With no profile it defaults to *; the
# dev profile ignores it and always allows http://localhost:5173.
CORS_ORIGINS=http://localhost:3000

# Spring profile. Use `dev` locally: the console OTP logger is
# @Profile({"dev","test","mysql-test"}), so with no profile set AND a blank
# SMTP_HOST the app has no OtpEmailService bean at all and refuses to start.
SPRING_PROFILES_ACTIVE=prod

# Agent invites: frontend page an invited agent lands on to set their
# first password. REQUIRED in prod: if it is unset or blank, StartupValidator
# aborts startup with an error naming INVITE_LINK_BASE_URL. Outside prod it
# defaults to http://localhost:5173/agent-setup.
INVITE_LINK_BASE_URL=https://your-frontend.example.com/agent-setup

# Agent invite lifetime in hours (optional, defaults to 168 = one week)
INVITE_TTL_HOURS=168

# SMTP (outbound email for OTP codes and agent invites).
# Leaving SMTP_HOST blank makes the app fall back to logging OTP codes to
# the console instead of emailing (fine for dev, not for real users).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
MAIL_FROM=your-email@gmail.com
